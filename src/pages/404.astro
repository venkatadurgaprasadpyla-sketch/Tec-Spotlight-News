---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <div class="container page">
    <h1>This page isn't in the spotlight</h1>
    <p>It may have moved, or the link may be wrong. Try the <a href="/">home page</a> or <a href="/search/">search</a>.</p>
  </div>
</BaseLayout>
<style>.page { padding: 3rem 16px; }</style>
