---
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  description: string;
  updated?: string;
}
const { title, description, updated } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="container page">
    <h1>{title}</h1>
    {updated && <p class="muted small">Last updated: {updated}</p>}
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
<style>
  .page { padding-top: 2rem; }
  .small { font-size: 0.9rem; margin-top: -0.25rem; }
</style>
