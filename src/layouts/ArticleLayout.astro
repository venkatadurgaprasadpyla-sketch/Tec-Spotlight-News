---
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AffiliateButtons from '../components/AffiliateButtons.astro';
import ShopButtons from '../components/ShopButtons.astro';
import AdSlot from '../components/AdSlot.astro';
import PromoCards from '../components/PromoCards.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { pickPromos } from '../lib/promos.mjs';
import { SITE } from '../data/site';
import { formatDate } from '../data/posts';

interface Props {
  kind: 'news' | 'guide';
  slug: string;
  title: string;
  seoTitle?: string;
  focusKeyword?: string;
  keywords?: string[];
  description: string;
  date: Date;
  updated?: Date;
  author: string;
  category: { slug: string; name: string };
  image?: string;
  imageAlt?: string;
  imageCredit?: { name: string; source: string; url: string };
  draft: boolean;
  affiliate: boolean;
  tools: string[];
  promos?: boolean;
  shop?: { amazonIn?: string; flipkart?: string; amazonAe?: string };
  minutes: number;
}

const p = Astro.props;
const base = p.kind === 'news' ? '/news' : '/guides';
const url = new URL(Astro.url.pathname, Astro.site).toString();

// Affiliate banners that fit this article: the first sits mid-article (added at
// build time), the next two at the end. The disclosure shows whenever any do.
const promos = p.promos === false ? [] : pickPromos({ slug: p.slug, category: p.category.slug, tools: p.tools, count: 3 });
const showDisclosure = p.affiliate || promos.length > 0;

const tags = [...new Set([p.focusKeyword, ...(p.keywords ?? [])].filter((k): k is string => !!k))];
const article = {
  '@context': 'https://schema.org',
  '@type': p.kind === 'news' ? 'NewsArticle' : 'Article',
  headline: p.title,
  inLanguage: 'en',
  articleSection: p.category.name,
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
  description: p.description,
  datePublished: p.date.toISOString(),
  dateModified: (p.updated ?? p.date).toISOString(),
  author: { '@type': 'Person', name: p.author, url: new URL('/about/', Astro.site).toString() },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', Astro.site).toString() },
  },
  mainEntityOfPage: url,
  ...(p.image
    ? {
        image: [
          { '@type': 'ImageObject', url: new URL(p.image, Astro.site).toString(), width: 1200, height: 630 },
        ],
      }
    : {}),
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: p.kind === 'news' ? 'News' : 'Guides', item: new URL(`${base}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: p.category.name, item: new URL(`${base}/category/${p.category.slug}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 4, name: p.title, item: url },
  ],
};
---
<BaseLayout
  title={p.seoTitle ?? p.title}
  description={p.description}
  image={p.image}
  imageAlt={p.imageAlt}
  type="article"
  schema={[article, breadcrumbs]}
  keywords={tags}
  section={p.category.name}
  published={p.date}
  modified={p.updated}
  noindex={p.draft}
>
  <article class="container article">
    <header class="head">
      {p.draft && <p class="draft-banner">Draft preview. This post is not on the live site.</p>}
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${base}/`}>{p.kind === 'news' ? 'News' : 'Guides'}</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}/category/${p.category.slug}/`}>{p.category.name}</a>
      </nav>
      <h1>{p.title}</h1>
      <p class="byline muted">
        By <a href="/about/">{p.author}</a> ·
        <time datetime={p.date.toISOString()}>{formatDate(p.date)}</time>
        {p.updated && <> · Updated <time datetime={p.updated.toISOString()}>{formatDate(p.updated)}</time></>}
        · {p.minutes} min read
      </p>
    </header>

    {showDisclosure && <AffiliateDisclosure />}
    <slot name="top" />

    {p.image && (
      <figure class="hero">
        <img src={p.image} alt={p.imageAlt ?? ''} width="1200" height="630" />
        {p.imageCredit && (
          <figcaption>
            Photo: <a href={p.imageCredit.url} rel="noopener">{p.imageCredit.name}</a> on {p.imageCredit.source}
          </figcaption>
        )}
      </figure>
    )}

    <AdSlot slot="article-top" />

    <div class="prose">
      <slot />
    </div>

    <AdSlot slot="article-end" />

    <NewsletterSignup heading="Liked this? Get the next two stories by email" />

    {p.shop && <ShopButtons {...p.shop} />}
    <AffiliateButtons tools={p.tools} />
    <PromoCards items={promos.slice(1)} heading="Tools for this topic" />

    <slot name="bottom" />
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: 1.75rem;
  }
  .head,
  .article > :global(*) {
    max-width: var(--measure);
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .crumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .byline {
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }
  .byline a {
    color: inherit;
  }
  .hero {
    margin: 0 0 1.5rem;
  }
  .hero img {
    border-radius: var(--radius);
  }
  .hero figcaption {
    margin-top: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
