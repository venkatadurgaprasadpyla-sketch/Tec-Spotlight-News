---
const path = Astro.url.pathname;
const links = [
  { href: '/news/', label: 'News' },
  { href: '/guides/', label: 'Guides' },
  { href: '/about/', label: 'About', wide: true },
];
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="TechSpotlight News home">
      <img src="/images/brand/techspotlight-logo-dark.svg" alt="TechSpotlight News" width="220" height="44" />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li class={l.wide ? 'wide' : undefined}><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li>
          <a href="/search/" class="icon-link" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </a>
        </li>
        <li>
          <button class="icon-link theme-toggle" type="button" aria-label="Switch light or dark mode">
            <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    background: var(--header-bg);
    color: var(--header-text);
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 3px solid var(--amber);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 60px;
  }
  .logo img {
    width: auto;
    height: 34px;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a,
  .icon-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 40px;
    justify-content: center;
    padding: 0 10px;
    color: var(--header-text);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: 8px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  nav a:hover,
  .icon-link:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  nav a[aria-current='page'] {
    color: var(--glow);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .logo img {
      height: 30px;
    }
    .wide {
      display: none;
    }
    nav a,
    .icon-link {
      padding: 0 7px;
      font-size: 0.875rem;
    }
  }
</style>
