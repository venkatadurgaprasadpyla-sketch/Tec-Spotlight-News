---
interface Props {
  base: string;
  categories: readonly { slug: string; name: string }[];
  current?: string;
}
const { base, categories, current } = Astro.props;
---
<nav class="cats" aria-label="Categories">
  <a href={`${base}/`} aria-current={!current ? 'page' : undefined}>All</a>
  {categories.map((c) => (
    <a href={`${base}/category/${c.slug}/`} aria-current={current === c.slug ? 'page' : undefined}>{c.name}</a>
  ))}
</nav>

<style>
  .cats {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    margin: 0 0 1.5rem;
    scrollbar-width: none;
  }
  a {
    flex: none;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--heading);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  a[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  :global(:root[data-theme='dark']) a[aria-current='page'] {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--ink);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) a[aria-current='page'] {
      background: var(--amber);
      border-color: var(--amber);
      color: var(--ink);
    }
  }
</style>
